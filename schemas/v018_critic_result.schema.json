{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enh3bench.local/schemas/v018_critic_result.schema.json",
  "title": "M018 A2A deterministic critic result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "critic_result_id", "critic_type", "design_id", "verdict", "severity", "finding_code", "finding_text", "affected_variables", "evidence_refs", "recommended_resolution", "uncertainty", "blocking", "provenance"],
  "properties": {
    "schema_version": {"const": "0.18-critic-result.1"},
    "critic_result_id": {"type": "string", "pattern": "^CRIT18_[A-F0-9]{24}$"},
    "critic_type": {"enum": ["evidence_critic", "chemistry_critic", "electrochemical_critic", "engineering_critic", "safety_capability_critic"]},
    "design_id": {"type": "string", "pattern": "^DES18_[A-F0-9]{24}$"},
    "verdict": {"enum": ["pass", "warning", "fail", "not_evaluated"]},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "finding_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "finding_text": {"type": "string", "minLength": 1, "maxLength": 500},
    "affected_variables": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DV18_[A-F0-9]{24}$"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"}},
    "recommended_resolution": {"type": "string", "minLength": 1, "maxLength": 500},
    "uncertainty": {"enum": ["low", "medium", "high", "not_applicable"]},
    "blocking": {"type": "boolean"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "generation_method", "source_refs", "code_commit", "parent_ids"],
      "properties": {
        "generated_by": {"enum": ["deterministic_compiler", "human_configuration", "synthetic_fixture"]},
        "generation_method": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
        "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "parent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"}}
      }
    }
  }
}
