{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enh3bench.local/schemas/v018_simulation_job.schema.json",
  "title": "M018 A2A simulation routing job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "simulation_job_id", "design_id", "simulation_type", "simulation_target", "scientific_question", "required_inputs", "input_completeness", "boundary_conditions", "expected_outputs", "fidelity", "estimated_cost", "dependency_jobs", "status", "human_gate_required", "provenance"],
  "properties": {
    "schema_version": {"const": "0.18-simulation-job.1"},
    "simulation_job_id": {"type": "string", "pattern": "^SIM18_[A-F0-9]{24}$"},
    "design_id": {"type": "string", "pattern": "^DES18_[A-F0-9]{24}$"},
    "simulation_type": {"enum": ["surrogate", "COMSOL", "DFT", "MD", "no_simulation", "human_required"]},
    "simulation_target": {"enum": ["fluid_flow", "species_transport", "current_distribution", "pressure_drop", "residence_time", "concentration_uniformity", "gas_liquid_transport", "thermal_distribution", "adsorption", "activation_barriers", "surface_intermediates", "electronic_structure", "interfacial_reaction_energetics", "solvation_structure", "ion_pairing", "proton_donor_environment", "electrolyte_transport", "interfacial_organization", "SEI_precursor_environment", "not_applicable"]},
    "scientific_question": {"type": "string", "minLength": 1},
    "required_inputs": {"type": "array", "items": {"$ref": "#/$defs/simulationInput"}},
    "input_completeness": {"enum": ["complete", "incomplete", "unknown"]},
    "boundary_conditions": {"type": "array", "items": {"$ref": "#/$defs/boundaryCondition"}},
    "expected_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fidelity": {"enum": ["screening", "reduced_order", "high", "not_applicable"]},
    "estimated_cost": {"enum": ["low", "medium", "high", "unknown", "not_applicable"]},
    "dependency_jobs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SIM18_[A-F0-9]{24}$"}},
    "status": {"enum": ["draft", "blocked", "ready_for_human_gate", "approved", "completed", "cancelled", "not_applicable"]},
    "human_gate_required": {"type": "boolean"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "simulationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "value", "unit", "source_ref"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "status": {"enum": ["specified", "missing", "unknown", "not_applicable"]},
        "value": {"$ref": "#/$defs/scalar"},
        "unit": {"type": ["string", "null"]},
        "source_ref": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]}
      }
    },
    "boundaryCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "value", "unit"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "status": {"enum": ["specified", "missing", "unknown", "not_applicable"]},
        "value": {"$ref": "#/$defs/scalar"},
        "unit": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "generation_method", "source_refs", "code_commit", "parent_ids"],
      "properties": {
        "generated_by": {"enum": ["deterministic_compiler", "human_configuration", "synthetic_fixture"]},
        "generation_method": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
        "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "parent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"}}
      }
    }
  }
}
